---
import data from '../../curriculum/references.json';const {lang='fr'}=Astro.props;const l=lang as 'fr'|'en',en=l==='en';
const papers=data.references.filter(x=>x.type==='paper').sort((a,b)=>(a.year||0)-(b.year||0));
---
<p>{data.notice[l]}</p><h2>{en?'A chronology through original papers':'Une chronologie par les textes originaux'}</h2><p>{en?'A selected first collection, not an exhaustive history. Each contribution addresses a specific problem; later successes build on many earlier results.':'Une première sélection, sans prétention à l’exhaustivité. Chaque contribution répond à un problème ; les résultats ultérieurs s’appuient sur de nombreux travaux antérieurs.'}</p><div>{papers.map(r=><article class="module-row"><span class="chapter-index">{r.year}</span><h3><a href={r.url}>{r.title[l]}</a></h3><p>{r.description[l]}</p><small>{r.authors.join(', ')}</small></article>)}</div><h2>{en?'References & selected videos':'Références & vidéos choisies'}</h2>{data.references.filter(x=>x.type!=='paper').map(r=><article class="module-row" id={r.id}><span class="badge">{r.type} · {r.year||'—'}</span><h3><a href={r.url}>{r.title[l]}</a></h3><p>{r.description[l]}</p><small>{r.authors.join(', ')} · {en?'Checked':'Vérifié'} {r.verifiedAt}</small><p style="font-size:.75rem">{r.reuseNote[l]}</p></article>)}
