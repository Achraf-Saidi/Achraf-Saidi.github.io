---
import lessons from '../../curriculum/lessons.json';const {lang='fr'}=Astro.props;const en=lang==='en';const b=import.meta.env.BASE_URL.replace(/\/$/,'')+'/'+lang;
---
<section data-notebook data-lang={lang}><p>{en?'Progress lives in this browser only. Clearing browser data removes it. Export regularly to move it to another device; there is no automatic synchronization.':'La progression reste dans ce navigateur. Effacer ses données la supprime. Exportez régulièrement pour changer d’appareil ; aucune synchronisation automatique.'}</p><p><strong data-count>0 / {lessons.length}</strong> {en?'lessons completed':'cours terminés'}</p><progress max={lessons.length} value="0" aria-label={en?'Learning progress':'Progression'}></progress><div class="home-actions"><button class="tool-btn" type="button" data-export>{en?'Export my notebook':'Exporter mon carnet'}</button><label class="tool-btn secondary">{en?'Import a notebook':'Importer un carnet'}<input type="file" accept="application/json,.json" data-import style="display:block;max-width:230px;font-size:.75rem;margin-top:.4rem"/></label></div><p role="status" data-message></p><h2>{en?'My saved lessons':'Mes cours enregistrés'}</h2><ul data-list></ul><div class="notes"><h2>{en?'My study notes':'Mes notes de travail'}</h2><label>{en?'Personal notes, saved locally':'Notes personnelles, enregistrées localement'}<textarea data-notes placeholder={en?'What did I understand? What should I revisit?':'Qu’ai-je compris ? Que dois-je revoir ?'}></textarea></label><button class="tool-btn" type="button" data-save>{en?'Save notes':'Enregistrer les notes'}</button></div><h2>{en?'All published lessons':'Tous les cours publiés'}</h2><ol>{lessons.map(x=><li><a href={`${b}/${x.route}/`}>{x.title[lang as 'fr'|'en']}</a> <span data-progress-id={x.id}></span></li>)}</ol></section>
<script>
import {readProgress,writeProgress,validateProgress} from '../lib/progress';import lessons from '../../curriculum/lessons.json';
for(const root of document.querySelectorAll<HTMLElement>('[data-notebook]')){const en=root.dataset.lang==='en',l=en?'en':'fr',message=root.querySelector<HTMLElement>('[data-message]')!,notes=root.querySelector<HTMLTextAreaElement>('[data-notes]')!;
function render(){const p=readProgress();const count=lessons.filter(x=>p.completed.includes(x.id)).length;root.querySelector('[data-count]')!.textContent=`${count} / ${lessons.length}`;root.querySelector('progress')!.value=count;notes.value=p.notes.global||'';const list=root.querySelector('[data-list]')!;list.replaceChildren();for(const x of lessons.filter(x=>p.bookmarks.includes(x.id))){const li=document.createElement('li'),a=document.createElement('a');a.textContent=x.title[l];a.href=`${import.meta.env.BASE_URL.replace(/\/$/,'')}/${l}/${x.route}/`;li.append(a);list.append(li);}if(!list.children.length){const li=document.createElement('li');li.textContent=en?'No bookmarks yet. Save one from any lesson.':'Aucun cours enregistré. Ajoutez-en depuis un cours.';list.append(li);}root.querySelectorAll<HTMLElement>('[data-progress-id]').forEach(el=>el.textContent=p.completed.includes(el.dataset.progressId!)?'✓':'');}
root.querySelector('[data-export]')!.addEventListener('click',()=>{const p=readProgress();p.notes.global=notes.value;writeProgress(p);const url=URL.createObjectURL(new Blob([JSON.stringify(p,null,2)],{type:'application/json'}));const a=document.createElement('a');a.href=url;a.download='achraf-notebooks-progress.json';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);});
root.querySelector('[data-import]')!.addEventListener('change',async e=>{const file=(e.target as HTMLInputElement).files?.[0];if(!file)return;try{if(file.size>5000000)throw new Error();const p=JSON.parse(await file.text());if(!validateProgress(p))throw new Error();if(!writeProgress(p)){message.textContent=en?'Browser storage unavailable.':'Stockage du navigateur indisponible.';return;}render();message.textContent=en?'Notebook imported. Existing local progress was replaced.':'Carnet importé. La progression locale précédente a été remplacée.';}catch{message.textContent=en?'Invalid file. Expected an Achraf Notebooks JSON export under 5 MB.':'Fichier invalide. Utilisez un export JSON Achraf Notebooks de moins de 5 Mo.';}});
root.querySelector('[data-save]')!.addEventListener('click',()=>{const p=readProgress();p.notes.global=notes.value;message.textContent=writeProgress(p)?(en?'Notes saved on this device.':'Notes enregistrées sur cet appareil.'):(en?'Unable to save. Export your notes.':'Enregistrement impossible. Exportez vos notes.');});render();}
</script>
