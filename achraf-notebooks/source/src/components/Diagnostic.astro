---
const {lang='fr'}=Astro.props;const en=lang==='en';
const questions=en?[['1/2 + 1/3 = ?', ['2/5','5/6','1'],1,'foundations/numbers'],['If 2x+1=7, x = ?', ['2','3','4'],1,'foundations/algebra'],['f(x)=x². Its derivative at x=2 is…',['2','4','8'],1,'foundations/derivatives'],['Does P(A|B) always equal P(B|A)?',['Yes','No'],1,'mathematics/probability'],['Can a 3×2 matrix multiply a 2-dimensional column vector?',['Yes, giving dimension 3','No'],0,'mathematics/linear-algebra']]:[['1/2 + 1/3 = ?', ['2/5','5/6','1'],1,'foundations/numbers'],['Si 2x+1=7, x = ?', ['2','3','4'],1,'foundations/algebra'],['f(x)=x². Sa dérivée en x=2 vaut…',['2','4','8'],1,'foundations/derivatives'],['P(A|B) vaut-il toujours P(B|A) ?',['Oui','Non'],1,'mathematics/probability'],['Une matrice 3×2 peut-elle multiplier un vecteur colonne de dimension 2 ?',['Oui, la sortie a 3 coordonnées','Non'],0,'mathematics/linear-algebra']];
---
<form class="lab" data-diagnostic data-lang={lang}><p>{en?'Five orientation questions, not a certification or a complete placement exam. Your answers stay on this page.':'Cinq questions d’orientation, sans certification. Ce diagnostic ne mesure pas tous les prérequis. Vos réponses restent sur cette page.'}</p>{questions.map(([q,opts,correct,path],i)=><fieldset style="border:0;padding:1rem 0" data-path={path} data-correct={correct}><legend><strong>{i+1}. {q}</strong></legend>{(opts as string[]).map((opt,j)=><label><input type="radio" name={`q${i}`} value={j} required/> {opt}</label>)}</fieldset>)}<button type="submit">{en?'Suggest a starting point':'Proposer un point de départ'}</button><div role="status" data-result></div></form>
<script>
for(const form of document.querySelectorAll<HTMLFormElement>('[data-diagnostic]'))form.addEventListener('submit',e=>{e.preventDefault();const en=form.dataset.lang==='en',data=new FormData(form),failed=[...form.querySelectorAll<HTMLElement>('fieldset')].filter((el,i)=>Number(data.get(`q${i}`))!==Number(el.dataset.correct)),out=form.querySelector('[data-result]')!;out.replaceChildren();const p=document.createElement('p');p.textContent=failed.length?(en?'Revisit these foundations before moving on:':'Reprenez ces fondations avant de poursuivre :'):(en?'All five answers are correct. Start with regression, checking its programming prerequisites.':'Les cinq réponses sont exactes. Commencez par la régression, en vérifiant ses prérequis de programmation.');out.append(p);const paths=failed.length?failed.map(el=>el.dataset.path!):['learning/regression'];for(const path of paths){const a=document.createElement('a');a.href=`${import.meta.env.BASE_URL.replace(/\/$/,'')}/${en?'en':'fr'}/${path}/`;a.textContent=path.split('/').at(-1)!;a.style.display='block';out.append(a);}});
</script>
