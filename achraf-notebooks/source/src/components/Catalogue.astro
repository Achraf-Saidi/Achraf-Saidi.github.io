---
import curriculum from '../../curriculum/manifest.json';import lessons from '../../curriculum/lessons.json';
const {lang='fr'}=Astro.props;const l=lang as 'fr'|'en',en=l==='en';const b=import.meta.env.BASE_URL.replace(/\/$/,'')+'/'+l;
---
<div data-catalogue><div class="course-filters"><input type="search" aria-label={en?'Filter the curriculum':'Filtrer le programme'} placeholder={en?'Search a concept, course, algorithm…':'Chercher un concept, un cours, un algorithme…'} data-filter/><select aria-label={en?'Filter status':'Filtrer le statut'} data-status><option value="all">{en?'All content':'Tous les contenus'}</option><option value="published">{en?'Published lessons':'Cours publiés'}</option><option value="planned">{en?'Planned modules':'Modules prévus'}</option></select></div><p class="muted" style="font-size:.85rem">{en?'12 bilingual lessons available · 151 modules in the long-term roadmap. Estimated effort is indicative, not an accredited degree workload.':'12 cours bilingues disponibles · 151 modules dans le programme à long terme. Les durées sont indicatives et ne constituent pas un cursus diplômant.'}</p>
<h2>{en?'Ready to study':'Prêts à être étudiés'}</h2><div class="catalogue-grid">{lessons.map(x=><article data-entry data-status="published" data-search={`${x.title[l]} ${x.description[l]} ${x.id}`}><div><span class="chapter-index">{x.id}</span> <span class="badge">{en?'Published':'Publié'} · FR/EN</span></div><h3><a href={`${b}/${x.route}/`}>{x.title[l]}</a></h3><p>{x.description[l]}</p><small>{x.effort} min · {en?'Prerequisites':'Prérequis'} : {x.prerequisites.length?x.prerequisites.join(', '):(en?'none':'aucun')}</small></article>)}</div>
<h2>{en?'The complete academic roadmap':'Le programme académique complet'}</h2><p style="padding:1rem;border-left:3px solid var(--sl-color-accent);background:var(--sl-color-gray-6)"><strong>✦ {en?'Robotics & embodied AI':'Robotique & IA incarnée'}</strong> · 15 {en?'new modules':'nouveaux modules'} · <a href={`/achraf-notebooks/robotics/${l}/`}>{en?'Explore the robotics school':'Explorer la filière robotique'} →</a></p><p>{en?'Expand a school to see module outcomes, prerequisite links and topics. The initial lessons cover selected concepts within these modules, not their entire scope.':'Ouvrez une école pour consulter les objectifs, prérequis et thèmes. Les premiers cours traitent de concepts choisis dans ces modules, sans couvrir encore leur périmètre entier.'}</p>
{curriculum.schools.map(s=><section class="roadmap-school" id={`school-${s.id.toLowerCase()}`} data-school><details open={s.id==='K'}><summary><span class="chapter-index">{s.id} /</span><strong>{s.title[l]}</strong><span class="badge">{s.moduleIds.length} {en?'modules planned':'modules prévus'}</span></summary><p>{s.description[l]}</p><p class="muted">{en?'Prerequisite schools':'Écoles préalables'} : {s.prerequisiteSchools.length?s.prerequisiteSchools.map(id=><a href={`#school-${id.toLowerCase()}`}>{id} </a>):(en?'none':'aucune')}</p>{curriculum.modules.filter(m=>m.schoolId===s.id).map(m=><article class="module-row" id={`module-${m.id}`} data-entry data-status="planned" data-search={`${m.title[l]} ${m.description[l]} ${m.topics.join(' ')} ${m.id}`}><h3>{m.id} · {m.title[l]} <span class="badge">{en?'Planned':'Prévu'}</span></h3><p><a href={`/achraf-notebooks/academy/${l}/?id=${m.id}`}>{en?'Study this module (lesson or guided syllabus)':'Étudier le module (cours ou parcours guidé)'} →</a></p><p>{m.description[l]}</p><ul>{m.outcomes[l].map(o=><li>{o}</li>)}</ul><small>{en?'Prerequisites':'Prérequis'} : {m.prerequisites.length?m.prerequisites.map(id=><a href={`#module-${id}`}>{id} </a>):(en?'none':'aucun')} · ~{m.estimatedHours} h</small><details><summary>{en?'Detailed topic inventory':'Inventaire détaillé des thèmes'}</summary><p lang="en">{m.topics.join(' · ')}</p><small>{en?'The shared technical topic inventory is currently in English; all course titles, outcomes and published lessons are available in both languages.':'Cet inventaire technique partagé est actuellement en anglais ; les titres, objectifs et cours publiés sont disponibles dans les deux langues.'}</small></details></article>)}</details></section>)}<p data-no-results hidden>{en?'No matching entry. Try a broader term.':'Aucun résultat. Essayez un terme plus général.'}</p></div>
<script>
const normalize=(x:string)=>x.normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase();
for(const root of document.querySelectorAll('[data-catalogue]')){const input=root.querySelector<HTMLInputElement>('[data-filter]')!,select=root.querySelector<HTMLSelectElement>('[data-status]')!;function filter(){const q=normalize(input.value),status=select.value;let count=0;root.querySelectorAll<HTMLElement>('[data-entry]').forEach(el=>{const match=normalize(el.dataset.search||'').includes(q)&&(status==='all'||status===el.dataset.status);el.hidden=!match;if(match)count++;});root.querySelectorAll<HTMLElement>('[data-school]').forEach(s=>{s.hidden=![...s.querySelectorAll<HTMLElement>('[data-entry]')].some(e=>!e.hidden);const d=s.querySelector('details');if(d&&(q||status==='planned'))d.open=true;});root.querySelector<HTMLElement>('[data-no-results]')!.hidden=count>0;}input.addEventListener('input',filter);select.addEventListener('change',filter);}
</script>
