---
const {id,lang='fr',minutes=30}=Astro.props;const en=lang==='en';
---
<div class="lesson-tools" data-lesson={id} data-lang={lang}><small>{minutes} min · {en?'Reading & practice':'Lecture & pratique'}</small><button type="button" data-complete>{en?'Mark complete':'Marquer terminé'}</button><button type="button" data-bookmark>{en?'Bookmark':'Garder dans mon carnet'}</button><button type="button" data-focus>{en?'Focus mode':'Mode concentration'}</button><small role="status" data-state></small></div>
<div class="reading-bar" aria-hidden="true" style="position:fixed;top:0;left:0;height:3px;background:var(--green);z-index:100;width:0"></div>
<script>
import {readProgress,writeProgress} from '../lib/progress';
for(const el of document.querySelectorAll<HTMLElement>('[data-lesson]')){const id=el.dataset.lesson!,en=el.dataset.lang==='en';let p=readProgress();const message=el.querySelector<HTMLElement>('[data-state]')!;
function update(){el.querySelector('[data-complete]')!.textContent=p.completed.includes(id)?(en?'✓ Completed':'✓ Terminé'):(en?'Mark complete':'Marquer terminé');el.querySelector('[data-bookmark]')!.textContent=p.bookmarks.includes(id)?(en?'★ Bookmarked':'★ Dans mon carnet'):(en?'Bookmark':'Garder dans mon carnet');}
for(const [sel,key] of [['[data-complete]','completed'],['[data-bookmark]','bookmarks']] as const){el.querySelector(sel)!.addEventListener('click',()=>{p=readProgress();p[key]=p[key].includes(id)?p[key].filter(v=>v!==id):[...p[key],id];message.textContent=writeProgress(p)?(en?'Saved on this device.':'Enregistré sur cet appareil.'):(en?'Storage unavailable. Export your work.':'Stockage indisponible. Exportez votre travail.');update();});}
el.querySelector('[data-focus]')!.addEventListener('click',()=>document.documentElement.classList.toggle('focus-mode'));update();
const bar=document.querySelector<HTMLElement>('.reading-bar');if(bar)window.addEventListener('scroll',()=>{const height=document.documentElement.scrollHeight-innerHeight;bar.style.width=`${height>0?Math.min(100,100*scrollY/height):0}%`;},{passive:true});
}
</script>
