---
import Lab from './Lab.astro';
const {lang='fr'}=Astro.props;const en=lang==='en';const b=import.meta.env.BASE_URL.replace(/\/$/,'')+'/'+lang;
const paths=[['01',en?'Start from zero':'Repartir de zéro',en?'Numbers, algebra, functions, limits and derivatives.':'Nombres, algèbre, fonctions, limites et dérivées.','foundations/numbers'],['02',en?'Reason with uncertainty':'Raisonner dans l’incertain',en?'Probability, Bayesian reasoning and statistical inference.':'Probabilités, raisonnement bayésien et inférence statistique.','mathematics/probability'],['03',en?'Make ideas executable':'Donner vie aux idées',en?'Scientific Python and R. Understand every line.':'Python et R scientifiques. Comprendre chaque ligne.','programming/python'],['04',en?'Understand how models learn':'Comprendre l’apprentissage',en?'From least squares to neural network gradients.':'Des moindres carrés aux gradients des réseaux de neurones.','learning/regression']];
---
<div class="home"><nav class="home-nav" aria-label={en?'Library sections':'Sections de la bibliothèque'}><a href={`${b}/curriculum/`}>{en?'The curriculum':'Le programme'}</a><a href={`${b}/labs/`}>{en?'Interactive labs':'Les laboratoires'}</a><a href={`${b}/projects/`}>{en?'Projects':'Les projets'}</a><a href={`${b}/research/multiomics/`}>Multi-Omics & AI ↗</a></nav>
<section class="home-hero"><div><div class="eyebrow">{en?'An open library · By Achraf Saidi':'Une bibliothèque ouverte · By Achraf Saidi'}</div><h1 id="_top" data-page-title>{en?'Understand.':'Comprendre.'}<br/>{en?'From the ground':'Depuis les'}<br/><em>{en?'up.':'fondations.'}</em></h1><p>{en?'Mathematics, statistics and artificial intelligence, one idea at a time. Build your intuition, work through the proofs, then bring the ideas to life in code.':'Les mathématiques, les statistiques et l’intelligence artificielle, une idée après l’autre. Construire l’intuition, dérouler les calculs, puis donner vie aux idées par le code.'}</p><div class="home-actions"><a href={`${b}/start/`}>{en?'Start learning':'Commencer à apprendre'} <span aria-hidden="true">↗</span></a><a href={`${b}/curriculum/`}>{en?'Explore the curriculum':'Explorer le programme'}</a></div></div><div class="graph-paper"><Lab kind="derivative" lang={lang} compact/><p class="graph-note">{en?'A small change. A fundamental idea.':'Un petit changement. Une idée fondamentale.'}</p></div></section>
<div class="home-strip"><div><strong>12</strong>{en?'original lessons · FR & EN':'cours originaux · FR & EN'}</div><div><strong>5</strong>{en?'interactive experiments':'expériences interactives'}</div><div><strong>Python · R</strong>{en?'read, modify, execute':'lire, modifier, exécuter'}</div><div><strong>{en?'Always open':'En accès libre'}</strong>{en?'no account · no paywall':'sans compte · sans abonnement'}</div></div>
<section class="home-section"><div class="section-header"><div><div class="eyebrow">01 / {en?'Find your path':'Trouver son chemin'}</div><h2>{en?'Every idea has foundations.':'Chaque idée a ses fondations.'}</h2></div><a href={`${b}/curriculum/`}>{en?'The complete roadmap':'La feuille de route complète'} →</a></div><div class="path-list">{paths.map(([n,title,desc,href])=><a href={`${b}/${href}/`}><span class="chapter-index">{n} /</span><h3>{title}</h3><p>{desc}</p><span aria-hidden="true">↗</span></a>)}</div><p class="muted" style="font-size:.8rem;margin-top:1rem">{en?'The roadmap covers 12 schools. Only the lessons marked Published are ready to study.':'La feuille de route couvre 12 écoles. Seuls les cours marqués Publié sont prêts à être étudiés.'}</p></section>
<section class="home-section"><div class="section-header"><div><div class="eyebrow">02 / {en?'Open your first notebook':'Ouvrir un premier carnet'}</div><h2>{en?'A slope. A limit. A new language.':'Une pente. Une limite. Un nouveau langage.'}</h2></div></div><article class="home-feature"><div><span class="badge">{en?'FOUNDATIONS · 55 MIN':'FONDATIONS · 55 MIN'}</span><h3>{en?'Where derivatives come from':'D’où viennent les dérivées ?'}</h3><p>{en?'How can we measure change at a single instant? Begin with two points on a curve, let them approach each other, and discover the idea that powers optimization and neural networks.':'Comment mesurer un changement à un instant précis ? Partir de deux points sur une courbe, les rapprocher, puis découvrir l’idée qui permet d’optimiser et d’entraîner des réseaux de neurones.'}</p><a href={`${b}/foundations/derivatives/`}>{en?'Read the notebook':'Lire le carnet'} →</a></div><div class="formula-art" aria-label={en?'Derivative of x squared equals 2x':'La dérivée de x carré vaut 2x'}><div>f′(x) = lim<sub style="font-size:.4em">h → 0</sub><br/><span style="font-size:.7em">( (x + h)² − x² ) / h</span><br/><span style="color:var(--gold)">= 2x</span></div></div></article></section>
<section class="home-section"><div class="section-header"><div><div class="eyebrow">03 / {en?'Theory meets the world':'Relier la théorie au réel'}</div><h2>{en?'Learn by investigating.':'Apprendre en explorant.'}</h2></div></div><div class="feature-links"><a href={`${b}/projects/`}><div class="eyebrow">{en?'Reproducible project':'Projet reproductible'}</div><h3>{en?'A line that learns':'Une droite qui apprend'}</h3><p>{en?'Derive a baseline, fit a model and test it on observations it has never seen.':'Dériver une référence, ajuster un modèle et le tester sur des observations jamais vues.'}</p><span>↗</span></a><a href={`${b}/research/multiomics/`}><div class="eyebrow">{en?'Research pathway':'Parcours recherche'}</div><h3>{en?'One organism, many views':'Un organisme, plusieurs regards'}</h3><p>{en?'DNA, RNA, proteins: learn what biological data measures before integrating it with AI.':'ADN, ARN, protéines : comprendre les mesures biologiques avant de les intégrer avec l’IA.'}</p><span>↗</span></a><a href={`${b}/references/`}><div class="eyebrow">{en?'The history of ideas':'L’histoire des idées'}</div><h3>{en?'How did we get here?':'Comment en est-on arrivé là ?'}</h3><p>{en?'From a mathematical question to a scientific breakthrough. Explore original sources and the ideas connecting them.':'D’une question mathématique à une avancée scientifique. Retrouver les sources et les idées qui les relient.'}</p><span>↗</span></a></div></section>
<section class="home-end"><div class="eyebrow">{en?'An independent, open-source project':'Un projet indépendant et open source'}</div><h2>{en?'Knowledge grows when it is shared.':'Le savoir grandit quand on le partage.'}</h2><p>{en?'Original explanations. Explicit assumptions. Reproducible code. A library built to grow, with honest editorial status and room for scientific review.':'Des explications originales. Des hypothèses explicites. Du code reproductible. Une bibliothèque conçue pour grandir, avec un avancement transparent et une place pour la relecture scientifique.'}</p><a href={`${b}/about/`}>{en?'About the project & contributing':'Le projet & les contributions'} →</a></section></div>
