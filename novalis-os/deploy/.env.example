# Copy to .env on the target server only, chmod 600. Never commit the real file.
NOVALIS_APP_DOMAIN=app.novalisai.com
NOVALIS_APP_ORIGIN=https://app.novalisai.com
NOVALIS_PUBLIC_ORIGINS=https://www.novalisai.com,https://novalisai.com,https://achraf-saidi.github.io
NOVALIS_ORG_ID=novalis
NOVALIS_STORAGE_PATH=/srv/novalis-os/data
NOVALIS_BACKUP_PATH=/srv/novalis-os/backups
# Shared VPS: local backend port and initial resource ceilings.
# Confirm the free port and available capacity before starting anything.
NOVALIS_BACKEND_PORT=18080
NOVALIS_APP_MEMORY=512m
NOVALIS_APP_CPUS=1.0
NOVALIS_WORKER_MEMORY=256m
NOVALIS_WORKER_CPUS=0.5
# Generate locally on the server with secrets.token_bytes(32) and URL-safe base64.
NOVALIS_ENCRYPTION_KEY=
NOVALIS_MAIL_ENABLED=false
NOVALIS_SMTP_HOST=
NOVALIS_SMTP_PORT=587
NOVALIS_SMTP_USER=
NOVALIS_SMTP_PASSWORD=
NOVALIS_SMTP_FROM=contact@novalisai.com
# Hosted one-off EUR payments. Keep disabled until merchant onboarding and provider QA.
NOVALIS_PAYMENTS_MODE=disabled
NOVALIS_MOLLIE_TEST_KEY=
NOVALIS_MOLLIE_LIVE_KEY=
NOVALIS_PAYMENTS_LIVE_ENABLED=false
